{
  "name": "@nb/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "PDF markup and takeoff for construction drawings",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "tsc -p . && electron .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "package": "pnpm --filter @nb/web build && tsc -p . && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "5.9.3"
  }
}
