# Copy to .env.local (git-ignored) to enable Live Sessions in Google Drive and OneDrive.
# None of these are secrets: browser apps ship them publicly. Setup: docs/CLOUD-SETUP.md.
VITE_GOOGLE_CLIENT_ID=705891075926-s7vprnvrs7c6apvvbhphe289tsq9sirs.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=AIzaSyBSboYfy3IESdBeKB4LgNJN-9Ml4F3TX1E
# The Cloud project number (Dashboard → Project info).
VITE_GOOGLE_APP_ID=705891075926
# Live Sessions in OneDrive: an Entra ID app registration's client ID (see docs/CLOUD-SETUP.md).
VITE_MICROSOFT_CLIENT_ID=b1c13541-0b78-4c60-8ca4-308aa9b23bd0
# Optional: common (default: work, school and personal accounts), consumers, organizations, or a tenant ID.
VITE_MICROSOFT_TENANT=
# Desktop app only. A Google Cloud OAuth client of type Desktop (not the web client above).
# The app chooses http://127.0.0.1:<port> when someone signs in.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
# The Desktop client's secret. Google requires it on the token request; it is not confidential
# in an installed app.
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=
# Optional: an API key for the desktop app, restricted to the Drive and Picker APIs but not to
# websites (app://redcolumn sends no website referrer). Falls back to VITE_GOOGLE_API_KEY.
VITE_GOOGLE_DESKTOP_API_KEY=
