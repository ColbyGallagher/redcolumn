{
  "name": "@nb/server",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "redcolumn-admin": "src/cli.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "admin": "node --experimental-strip-types src/cli.ts",
    "migrate": "node --experimental-strip-types src/cli.ts migrate",
    "typecheck": "tsc -p .",
    "test": "node --test --test-concurrency=1 --experimental-strip-types src/*.test.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.2",
    "@nb/ops": "workspace:*",
    "@nb/pdf-core": "workspace:*",
    "@nb/policy": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.12.8",
    "kysely": "0.29.9",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@nb/sync": "workspace:*",
    "@types/node": "^26.6.1",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3"
  }
}
