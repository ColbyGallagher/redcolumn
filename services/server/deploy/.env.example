# redcolumn self-hosted server configuration
# Copy this file to .env and replace all placeholder values before starting.

# --- Domain & TLS (Caddy) ---------------------------------------------------
# Hostname clients use to reach the server (must match the TLS certificate).
REDCOLUMN_DOMAIN=review.northbridge.example

# Caddy TLS mode: org-ca | dns01 | internal-ca
# See docs/self-host/tls.md for details on each mode.
CADDY_MODE=internal-ca

# Optional: override the Caddy image (required for dns01 with an xcaddy build).
# CADDY_IMAGE=redcolumn-caddy-dns01:local

# For CADDY_MODE=org-ca: host directory containing server.crt and server.key.
TLS_CERTS_DIR=./certs
TLS_CERT_FILE=/etc/caddy/certs/server.crt
TLS_KEY_FILE=/etc/caddy/certs/server.key

# For CADDY_MODE=dns01: ACME account email and scoped DNS API token.
ACME_EMAIL=it-ops@northbridge.example
DNS_PROVIDER_API_TOKEN=

# --- Database (PostgreSQL 17) -----------------------------------------------
POSTGRES_DB=redcolumn
POSTGRES_USER=redcolumn
# Generate a strong random password (e.g. `openssl rand -base64 32`).
POSTGRES_PASSWORD=change-me-use-a-strong-random-password

# Connection string used by the server and redcolumn-admin.
# Keep POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB in sync with this URL.
DATABASE_URL=postgres://redcolumn:change-me-use-a-strong-random-password@postgres:5432/redcolumn

# --- Server runtime ---------------------------------------------------------
# Must match the public HTTPS origin(s) browsers use (comma-separated).
ALLOWED_ORIGINS=https://review.northbridge.example

# Always keep COOKIE_SECURE=true in production behind HTTPS.
COOKIE_SECURE=true

# Directory inside the server container where immutable PDF/asset blobs live.
BLOB_DIR=/var/lib/redcolumn/blobs

# Logging verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Run pending SQL migrations automatically on server startup.
AUTO_MIGRATE=true

# Session lifetime in hours (default: 168 = 7 days).
SESSION_TTL_HOURS=168

# Login rate limit per client IP.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000
