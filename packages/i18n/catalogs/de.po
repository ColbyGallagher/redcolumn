msgstr "Dieser Sitzungsordner kann nicht gelesen werden: {value}"

#: apps/web/src/studio/drive/DriveSession.ts
msgid "Could not invite {failed}."
msgstr "{failed} konnte nicht eingeladen werden."

#: apps/web/src/studio/drive/DriveSession.ts
