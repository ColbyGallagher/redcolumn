msgid "Callouts cite part {number} of the drawing number: {parts} for {targetNumber}."
msgstr "Les légendes citent la partie {number} du numéro de dessin : {parts} pour {targetNumber}."

#: apps/web/src/sheets/teachLinks.ts
msgid "Chainage"
msgstr "Chaînage"

#: apps/web/src/sheets/teachLinks.ts
msgid "Chainage {value} on the cross section links to the plan."
msgstr "Le chaînage {value} du profil en travers est lié au plan."

#: apps/web/src/sheets/teachLinks.ts
msgid "Chainages are written after {prefix}."
msgstr "Les chaînages sont écrits après {prefix}."

#: apps/web/src/sheets/teachLinks.ts
msgid "Find a detail callout and drag a box around it, with its number and the sheet it points to."
msgstr "Trouvez une légende de détail et tracez un cadre autour, avec son numéro et la feuille qu’elle désigne."

