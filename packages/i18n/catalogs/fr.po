msgid "redcolumn has not read the title of {page}, so it cannot tell that it is a {what} sheet. Check the title block's Sheet title box covers the title on that sheet."
msgstr "redcolumn n’a pas lu le titre de {page} ; il ne peut donc pas savoir que c’est une feuille de {what}. Vérifiez que le cadre Titre de la feuille du cartouche couvre le titre de cette feuille."

#: apps/web/src/sheets/teachLinks.ts
msgid "{mARK_KINDS} {value} on {where} goes to {value2} {value3} on {where2}."
msgstr "{mARK_KINDS} {value} sur {where} mène à {value2} {value3} sur {where2}."

