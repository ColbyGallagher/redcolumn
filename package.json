{
  "name": "redcolumn",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --filter @nb/web dev",
    "build": "pnpm --filter @nb/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "desktop": "node scripts/desktop.mjs",
    "e2e": "pnpm e2e:web && pnpm e2e:desktop",
    "e2e:web": "pnpm --filter @nb/e2e e2e:web",
    "e2e:desktop": "pnpm --filter @nb/e2e e2e:desktop",
    "e2e:fixtures": "pnpm --filter @nb/e2e fixtures",
    "e2e:report": "pnpm --filter @nb/e2e exec playwright show-report",
    "verify": "pnpm typecheck && pnpm test && pnpm build && node e2e/support/check-release.mjs && pnpm e2e",
    "bench:render": "node --experimental-transform-types --no-warnings --import ./apps/web/test/resolve-ts.mjs scripts/render-bench.mjs"
  },
  "devDependencies": {
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0"
  }
}
